---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { sections, phases, statusMeta, countByStatus, updatedAt, type Status } from '../data/roadmap';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const postsByNode: Record<string, { title: string; href: string }[]> = {};
for (const post of posts) {
  for (const id of post.data.nodes) {
    (postsByNode[id] ??= []).push({ title: post.data.title, href: `/posts/${post.id}/` });
  }
}

const counts = countByStatus();
const order: Status[] = ['done', 'doing', 'gap', 'skip'];
const phaseById = Object.fromEntries(phases.map((phase) => [phase.id, phase]));
const nodeData = Object.fromEntries(
  sections.flatMap((section) =>
    section.nodes.map((node) => [
      node.id,
      {
        label: node.label,
        section: section.title,
        status: node.status,
        statusLabel: statusMeta[node.status].label,
        color: statusMeta[node.status].color,
        note: node.note ?? null,
        next: node.next ?? null,
        phase: node.phase ? `${phaseById[node.phase].title} · ${phaseById[node.phase].period}` : null,
        posts: postsByNode[node.id] ?? [],
      },
    ]),
  ),
);
const todo = phases
  .filter((phase) => phase.id !== 3)
  .map((phase) => ({
    ...phase,
    nodes: sections.flatMap((section) => section.nodes.filter((node) => node.phase === phase.id && node.next)),
  }));
const lead = 'roadmap.sh AI Engineer 로드맵의 주제 위에 현재 상태를 표시합니다. 노드를 누르면 다음 할 일이 열립니다.';
---

<Base title="Applied AI Engineer 로드맵" description={lead} current="roadmap">
  <div class="ds-page rm">
    <header class="ds-article__header rm-head">
      <h1 class="ds-article__title">Applied AI Engineer 로드맵</h1>
      <p class="ds-article__lead">{lead}</p>
      <p class="rm-updated ds-tabular">갱신 {updatedAt}</p>
    </header>

    <ul class="rm-legend" aria-label="상태 범례">
      {
        order.map((status) => (
          <li class="rm-legend__item">
            <span class="rm-icon" data-status={status} aria-hidden="true" />
            <span>{statusMeta[status].label}</span>
            <span class="rm-legend__count ds-tabular">{counts[status]}</span>
          </li>
        ))
      }
    </ul>

    <ol class="rm-phases">
      {
        phases.map((phase) => (
          <li class="rm-phase">
            <span class="rm-phase__title">{phase.title}</span>
            <span class="rm-phase__period ds-tabular">{phase.period}</span>
            <span class="rm-phase__goal">{phase.goal}</span>
          </li>
        ))
      }
    </ol>

    <div class="rm-map">
      <p class="rm-start">Applied AI Engineer</p>
      {
        sections.map((section, index) => (
          <section class="rm-section" id={section.id} data-side={index % 2 === 0 ? 'right' : 'left'} aria-labelledby={`${section.id}-title`}>
            <h2 class="rm-main" id={`${section.id}-title`}>{section.title}</h2>
            <ul class="rm-subs">
              {section.nodes.map((node) => (
                <li>
                  <button type="button" class="rm-node" id={node.id} data-node={node.id} data-status={node.status} aria-haspopup="dialog">
                    <span class="rm-node__label">{node.label}</span>
                    <span class="rm-icon" data-status={node.status} role="img" aria-label={statusMeta[node.status].label} />
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <section class="ds-prose rm-todo" aria-labelledby="todo-title">
      <h2 id="todo-title">단계별 할 일</h2>
      {
        todo.map((phase) => (
          <>
            <h3>
              {phase.title} <span class="rm-todo__period ds-tabular">{phase.period}</span>
            </h3>
            <div class="ds-table-wrapper">
              <table>
                <thead>
                  <tr>
                    <th>노드</th>
                    <th>다음 할 일</th>
                  </tr>
                </thead>
                <tbody>
                  {phase.nodes.map((node) => (
                    <tr>
                      <td class="rm-todo__node"><a href={`#${node.id}`} data-open={node.id}>{node.label}</a></td>
                      <td>{node.next}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ))
      }
    </section>
  </div>

  <div class="ds-modal" id="node-modal" data-backdrop="fade" role="dialog" aria-modal="true" aria-labelledby="node-modal-title">
    <div class="ds-modal__backdrop" data-close></div>
    <div class="ds-modal__panel" tabindex="-1">
      <div class="ds-modal__header">
        <h2 class="ds-modal__title" id="node-modal-title"></h2>
        <button type="button" class="ds-btn" data-variant="ghost" data-size="sm" data-uniform data-close aria-label="닫기">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke-linecap="round" /></svg>
        </button>
      </div>
      <div class="ds-modal__body rm-detail">
        <p class="rm-detail__meta"><span class="ds-badge" data-variant="soft" data-modal-badge></span><span data-modal-section></span></p>
        <div data-modal-note-wrap>
          <h3 class="rm-detail__label">메모</h3>
          <p data-modal-note></p>
        </div>
        <div data-modal-next-wrap>
          <h3 class="rm-detail__label">다음 할 일</h3>
          <p data-modal-next></p>
          <p class="rm-detail__phase ds-tabular" data-modal-phase></p>
        </div>
        <div data-modal-posts-wrap>
          <h3 class="rm-detail__label">관련 글</h3>
          <ul class="rm-detail__posts" data-modal-posts></ul>
        </div>
      </div>
    </div>
  </div>

  <script is:inline type="application/json" id="node-data" set:html={JSON.stringify(nodeData)} />
  <script is:inline>
    (function () {
      var data = JSON.parse(document.getElementById('node-data').textContent);
      var modal = document.getElementById('node-modal');
      var panel = modal.querySelector('.ds-modal__panel');
      var opener = null;

      function fill(sel, text) { modal.querySelector(sel).textContent = text || ''; }

      function open(id, trigger) {
        var node = data[id];
        if (!node) return;
        opener = trigger || document.getElementById(id);
        fill('#node-modal-title', node.label);
        var badge = modal.querySelector('[data-modal-badge]');
        badge.textContent = node.statusLabel;
        badge.setAttribute('data-color', node.color);
        fill('[data-modal-section]', node.section);
        fill('[data-modal-note]', node.note);
        modal.querySelector('[data-modal-note-wrap]').hidden = !node.note;
        fill('[data-modal-next]', node.next);
        fill('[data-modal-phase]', node.phase);
        modal.querySelector('[data-modal-next-wrap]').hidden = !node.next;
        var list = modal.querySelector('[data-modal-posts]');
        list.textContent = '';
        node.posts.forEach(function (post) {
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = post.href;
          a.textContent = post.title;
          li.appendChild(a);
          list.appendChild(li);
        });
        modal.querySelector('[data-modal-posts-wrap]').hidden = node.posts.length === 0;
        modal.classList.remove('is-closing');
        modal.classList.add('is-open');
        panel.focus();
        if (location.hash !== '#' + id) history.replaceState(null, '', '#' + id);
      }

      function close() {
        if (!modal.classList.contains('is-open')) return;
        modal.classList.add('is-closing');
        setTimeout(function () { modal.classList.remove('is-open', 'is-closing'); }, 300);
        history.replaceState(null, '', location.pathname);
        if (opener) opener.focus();
      }

      document.addEventListener('click', function (event) {
        var trigger = event.target.closest('[data-node], [data-open]');
        if (trigger) {
          event.preventDefault();
          open(trigger.getAttribute('data-node') || trigger.getAttribute('data-open'), document.getElementById(trigger.getAttribute('data-node') || trigger.getAttribute('data-open')));
          return;
        }
        if (event.target.closest('[data-close]')) close();
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') close();
      });
      function openFromHash() {
        var id = decodeURIComponent(location.hash.slice(1));
        if (data[id] && !modal.classList.contains('is-open')) open(id);
      }
      window.addEventListener('hashchange', openFromHash);
      openFromHash();
    })();
  </script>
</Base>

<style is:global>
  .rm { max-width: 1048px; }
  .rm-head { padding-top: 32px; }
  .rm-updated { color: var(--color-text-tertiary); font-size: 14px; line-height: 20px; }

  .rm-legend { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 24px 0 0; padding: 0; list-style: none; font-size: 14px; line-height: 20px; color: var(--color-text-secondary); }
  .rm-legend__item { display: inline-flex; align-items: center; gap: 6px; }
  .rm-legend__count { color: var(--color-text-emphasis); font-weight: 600; }

  .rm-phases { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; margin: 24px 0 0; padding: 0; list-style: none; }
  .rm-phase { display: flex; flex-direction: column; gap: 2px; padding: 12px 16px; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .rm-phase__title { color: var(--color-text-emphasis); font-size: 14px; line-height: 20px; font-weight: 600; }
  .rm-phase__period { color: var(--color-text-tertiary); font-size: 12px; line-height: 18px; }
  .rm-phase__goal { color: var(--color-text-secondary); font-size: 14px; line-height: 20px; }

  .rm-icon { position: relative; display: inline-block; width: 16px; height: 16px; flex-shrink: 0; border-radius: var(--radius-full); }
  .rm-icon[data-status='done'] { background: var(--color-text-success-soft); }
  .rm-icon[data-status='done']::after { content: ''; position: absolute; left: 5px; top: 3px; width: 4px; height: 7px; border: solid var(--color-text-inverse); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .rm-icon[data-status='doing'] { border: 2px solid var(--color-text-info-soft); background: linear-gradient(90deg, var(--color-text-info-soft) 50%, transparent 50%); }
  .rm-icon[data-status='gap'] { border: 2px solid var(--color-text-warning-soft); }
  .rm-icon[data-status='skip'] { border: 2px dashed var(--color-border-strong); }

  .rm-map { position: relative; margin-top: 48px; padding-bottom: 24px; }
  .rm-start { position: relative; z-index: 1; width: fit-content; margin: 0 auto 8px; padding: 8px 16px; border-radius: var(--radius-full); background: var(--color-background-primary-soft); color: var(--color-text-emphasis); font-size: 14px; line-height: 20px; font-weight: 600; }
  .rm-section { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; padding: 20px 0; }
  .rm-main { position: relative; z-index: 1; margin: 0; padding: 10px 16px; border-radius: var(--radius-md); background: var(--color-background-primary-solid); color: var(--color-text-inverse); font-size: 16px; line-height: 24px; font-weight: 600; }
  .rm-subs { position: relative; display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0 0 0 32px; list-style: none; }
  .rm-subs::before { content: ''; position: absolute; top: -12px; bottom: 20px; left: 12px; border-left: 2px dotted var(--color-border-strong); }
  .rm-subs > li { position: relative; }
  .rm-subs > li::before { content: ''; position: absolute; top: 50%; left: -20px; width: 20px; border-top: 2px dotted var(--color-border-strong); }
  .rm-node { display: flex; width: 100%; min-height: 40px; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-text); font-size: 14px; line-height: 20px; text-align: left; cursor: pointer; transition: background-color var(--transition-duration-basic) var(--transition-ease-basic), border-color var(--transition-duration-basic) var(--transition-ease-basic); }
  .rm-node:hover { background: var(--color-surface-secondary); border-color: var(--color-border-strong); }
  .rm-node[data-status='gap'] { border-color: var(--color-border-warning-surface); }
  .rm-node[data-status='skip'] { border-style: dashed; color: var(--color-text-tertiary); }
  .rm-node[data-status='skip'] .rm-node__label { text-decoration: line-through; }
  .rm-node:target, .rm-node:focus-visible { outline: 2px solid var(--color-ring); outline-offset: 2px; }

  @media (width >= 768px) {
    .rm-phases { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .rm-map::before { content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px; transform: translateX(-1px); background: var(--color-border-strong); }
    .rm-section { grid-template-columns: minmax(0, 1fr) 240px minmax(0, 1fr); gap: 0; align-items: start; padding: 28px 0; }
    .rm-main { grid-column: 2; grid-row: 1; text-align: center; }
    .rm-subs { grid-row: 1; padding: 0; }
    .rm-subs > li::before { width: 24px; }
    .rm-section[data-side='right'] .rm-subs { grid-column: 3; padding-left: 48px; }
    .rm-section[data-side='right'] .rm-subs::before { top: 20px; bottom: 20px; left: 24px; }
    .rm-section[data-side='right'] .rm-subs::after { content: ''; position: absolute; top: 21px; left: 0; width: 24px; border-top: 2px dotted var(--color-border-strong); }
    .rm-section[data-side='right'] .rm-subs > li::before { left: -24px; }
    .rm-section[data-side='left'] .rm-subs { grid-column: 1; padding-right: 48px; }
    .rm-section[data-side='left'] .rm-subs::before { top: 20px; bottom: 20px; left: auto; right: 24px; border-left: 0; border-right: 2px dotted var(--color-border-strong); }
    .rm-section[data-side='left'] .rm-subs::after { content: ''; position: absolute; top: 21px; right: 0; width: 24px; border-top: 2px dotted var(--color-border-strong); }
    .rm-section[data-side='left'] .rm-subs > li::before { left: auto; right: -24px; }
  }

  .rm-detail { display: flex; flex-direction: column; gap: 4px; }
  .rm-detail p { margin: 0; color: var(--color-text); font-size: 14px; line-height: 22px; }
  .rm-detail__meta { display: flex; align-items: center; gap: 8px; margin-bottom: 8px !important; color: var(--color-text-secondary) !important; }
  .rm-detail__label { margin: 12px 0 0; color: var(--color-text-secondary); font-size: 12px; line-height: 18px; font-weight: 600; }
  .rm-detail__phase { color: var(--color-text-tertiary) !important; font-size: 12px !important; }
  .rm-detail__posts { margin: 0; padding-left: 18px; font-size: 14px; line-height: 22px; }
  .rm-detail [hidden] { display: none; }

  .rm-todo { margin-top: 24px; padding-bottom: 48px; }
  .rm-todo__period { color: var(--color-text-tertiary); font-size: 14px; font-weight: 400; }
  .rm-todo__node { white-space: nowrap; }
</style>
