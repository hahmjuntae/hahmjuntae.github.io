---
import { sections, parts, endNode, statusMeta, trendOf, trendTotal } from '../data/roadmap';
import '../styles/roadmap.css';

const partTitle = Object.fromEntries(parts.map((part) => [part.id, part.title]));
const nodeData = Object.fromEntries([
  ...sections.flatMap((section) =>
    section.nodes.map((node) => [
      node.id,
      {
        label: node.label,
        where: `${partTitle[section.part]} · ${section.title}`,
        status: node.status,
        goal: node.goal,
        todo: node.todo,
        resources: node.resources,
        refs: section.refs,
        part: section.part,
        section: section.id,
        trend: trendOf(node.id),
      },
    ]),
  ),
  [
    endNode.id,
    { label: endNode.label, where: 'Goal', status: endNode.status, goal: endNode.goal, todo: endNode.todo, resources: endNode.resources, refs: endNode.refs, part: 'ai', section: '', trend: trendOf(endNode.id), end: true },
  ],
]);
---

  <div class="ds-modal" id="node-modal" data-backdrop="fade" role="dialog" aria-modal="true" aria-labelledby="node-modal-title">
    <div class="ds-modal__backdrop" data-close></div>
    <div class="ds-modal__panel" tabindex="-1">
      <div class="ds-modal__header">
        <h2 class="ds-modal__title" id="node-modal-title"></h2>
        <button type="button" class="ds-btn" data-variant="ghost" data-size="sm" data-uniform data-close aria-label="닫기">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke-linecap="round" /></svg>
        </button>
      </div>
      <div class="ds-modal__body rm-detail">
        <p class="rm-detail__where" data-modal-where></p>
        <div class="rm-status" role="group" aria-label="진행 상태" data-modal-status>
          <button type="button" class="ds-btn" data-variant="outline" data-size="sm" data-set-status="learning" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 3.5h4.5A1.5 1.5 0 0 1 8 5v8a1.5 1.5 0 0 0-1.5-1.5H2zM14 3.5H9.5A1.5 1.5 0 0 0 8 5v8a1.5 1.5 0 0 1 1.5-1.5H14z" stroke-linejoin="round" /></svg>
            진행
          </button>
          <button type="button" class="ds-btn" data-variant="outline" data-size="sm" data-set-status="done" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 8.5 3 3 7-7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            완료
          </button>
          <button type="button" class="ds-btn" data-variant="outline" data-size="sm" data-set-status="skip" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" stroke-linecap="round" /></svg>
            건너뜀
          </button>
        </div>
        <h3 class="rm-detail__label">목표</h3>
        <p class="rm-detail__goal" data-modal-goal></p>
        <h3 class="rm-detail__label">할 일</h3>
        <ol class="rm-detail__todo" data-modal-todo></ol>
        <h3 class="rm-detail__label">무료 강의</h3>
        <ul class="rm-detail__res" data-modal-res></ul>
        <div data-modal-trend-wrap>
          <h3 class="rm-detail__label">교육 과정 동향</h3>
          <p data-modal-trend></p>
        </div>
        <h3 class="rm-detail__label">참고 로드맵</h3>
        <ul class="rm-refs" data-modal-refs></ul>
      </div>
    </div>
  </div>

  <script is:inline type="application/json" id="node-data" data-total={trendTotal} set:html={JSON.stringify(nodeData)} />
  <script is:inline type="application/json" id="status-meta" set:html={JSON.stringify(statusMeta)} />
  <script is:inline>
    (function () {
      var KEY = 'roadmap-progress-v1';
      var TOTAL = Number(document.getElementById('node-data').getAttribute('data-total'));
      var data = JSON.parse(document.getElementById('node-data').textContent);
      var meta = JSON.parse(document.getElementById('status-meta').textContent);
      var modal = document.getElementById('node-modal');
      var panel = modal.querySelector('.ds-modal__panel');
      var current = null;
      var opener = null;
      var overrides = {};
      try { overrides = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { overrides = {}; }

      function statusOf(id) { return overrides[id] || data[id].status; }

      function save() {
        try { localStorage.setItem(KEY, JSON.stringify(overrides)); } catch (e) {}
      }

      function paint(id) {
        var button = document.getElementById(id);
        if (!button || data[id].end) return;
        var status = statusOf(id);
        button.setAttribute('data-status', status);
        var icon = button.querySelector('.rm-icon');
        icon.setAttribute('data-status', status);
        icon.setAttribute('aria-label', meta[status].label);
      }

      function summarize() {
        var counts = { done: 0, learning: 0, pending: 0, skip: 0 };
        var total = 0;
        Object.keys(data).forEach(function (id) {
          if (data[id].end) return;
          counts[statusOf(id)] += 1;
          total += 1;
        });
        Object.keys(counts).forEach(function (status) {
          var el = document.querySelector('[data-count="' + status + '"]');
          if (el) el.textContent = counts[status];
        });
        var pct = total ? Math.round((counts.done / total) * 100) : 0;
        document.querySelector('[data-progress-done]').textContent = counts.done;
        document.querySelector('[data-progress-pct]').textContent = pct;
        document.querySelector('[data-progress-bar]').style.width = pct + '%';
        ['section', 'part'].forEach(function (key) {
          document.querySelectorAll('[data-' + key + '-progress]').forEach(function (el) {
            var target = el.getAttribute('data-' + key + '-progress');
            var done = 0;
            var all = 0;
            Object.keys(data).forEach(function (id) {
              if (data[id].end || data[id][key] !== target) return;
              all += 1;
              if (statusOf(id) === 'done') done += 1;
            });
            el.textContent = done + '/' + all;
          });
        });
        document.dispatchEvent(new CustomEvent('rm:change'));
      }

      function paintStatusButtons() {
        var status = current ? statusOf(current) : null;
        modal.querySelectorAll('[data-set-status]').forEach(function (btn) {
          var on = btn.getAttribute('data-set-status') === status;
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
          if (on) btn.setAttribute('data-selected', ''); else btn.removeAttribute('data-selected');
        });
      }

      function el(tag, text, attrs) {
        var node = document.createElement(tag);
        if (text) node.textContent = text;
        if (attrs) Object.keys(attrs).forEach(function (k) { node.setAttribute(k, attrs[k]); });
        return node;
      }

      function open(id) {
        var node = data[id];
        if (!node) return;
        current = id;
        opener = document.getElementById(id);
        modal.querySelector('#node-modal-title').textContent = node.label;
        modal.querySelector('[data-modal-where]').textContent = node.where;
        modal.querySelector('[data-modal-status]').hidden = !!node.end;
        modal.querySelector('[data-modal-goal]').textContent = node.goal;
        var todo = modal.querySelector('[data-modal-todo]');
        todo.textContent = '';
        node.todo.forEach(function (item) { todo.appendChild(el('li', item)); });
        var res = modal.querySelector('[data-modal-res]');
        res.textContent = '';
        node.resources.forEach(function (r) {
          var li = el('li');
          li.appendChild(el('a', r.title, { href: r.url, target: '_blank', rel: 'noopener' }));
          li.appendChild(el('span', r.kind + ' · ' + (r.lang === 'ko' ? '한국어' : '영어'), { class: 'rm-detail__res-meta' }));
          res.appendChild(li);
        });
        var trend = node.trend || { count: 0, tools: [] };
        modal.querySelector('[data-modal-trend-wrap]').hidden = trend.count === 0 && node.part !== 'ai';
        modal.querySelector('[data-modal-trend]').textContent = trend.count === 0
          ? '조사한 ' + TOTAL + '곳 중 다루는 곳이 없습니다.'
          : TOTAL + '곳 중 ' + trend.count + '곳에서 다룹니다.' + (trend.tools.length ? ' 주요 스택: ' + trend.tools.join(', ') : '');
        var refs = modal.querySelector('[data-modal-refs]');
        refs.textContent = '';
        node.refs.forEach(function (ref) {
          var li = el('li');
          li.appendChild(el('a', ref.name, { href: ref.url, target: '_blank', rel: 'noopener', class: 'ds-badge', 'data-variant': 'outline' }));
          refs.appendChild(li);
        });
        paintStatusButtons();
        modal.classList.remove('is-closing');
        modal.classList.add('is-open');
        modal.querySelector('.ds-modal__body').scrollTop = 0;
        panel.focus();
        if (location.hash !== '#' + id) history.replaceState(null, '', '#' + id);
      }

      function close() {
        if (!modal.classList.contains('is-open')) return;
        modal.classList.add('is-closing');
        setTimeout(function () { modal.classList.remove('is-open', 'is-closing'); }, 300);
        history.replaceState(null, '', location.pathname);
        current = null;
        if (opener) opener.focus();
      }

      function setStatus(status) {
        if (!current) return;
        var next = statusOf(current) === status ? 'pending' : status;
        if (next === data[current].status) delete overrides[current]; else overrides[current] = next;
        save();
        paint(current);
        paintStatusButtons();
        summarize();
      }

      document.addEventListener('click', function (event) {
        var set = event.target.closest('[data-set-status]');
        if (set) { setStatus(set.getAttribute('data-set-status')); return; }
        var trigger = event.target.closest('[data-node]');
        if (trigger) { event.preventDefault(); open(trigger.getAttribute('data-node')); return; }
        if (event.target.closest('[data-close]')) close();
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') close();
      });
      function openFromHash() {
        var id = decodeURIComponent(location.hash.slice(1));
        if (data[id] && !modal.classList.contains('is-open')) open(id);
      }
      window.addEventListener('hashchange', openFromHash);

      Object.keys(data).forEach(paint);
      summarize();
      openFromHash();
    })();
  </script>
